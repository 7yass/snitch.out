<BloxstrapCustomBootstrapper Version="1" Height="360" Width="520" Theme="Dark" Margin="30">
	<BloxstrapCustomBootstrapper.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#1A0B2E" Offset="0.0" />
			<GradientStop Color="#2D1B4E" Offset="0.5" />
			<GradientStop Color="#8B5CF6" Offset="1.0" />
		</LinearGradientBrush>
	</BloxstrapCustomBootstrapper.Background>
	<TitleBar Title="snitch.out" ShowMinimize="False" ShowClose="False" />
	<Image Source="{Icon}" Height="96" Width="96" HorizontalAlignment="Center" Margin="0,20,0,0" />
	<TextBlock HorizontalAlignment="Center" Name="StatusText" Width="460" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,140,0,0" />
	<ProgressBar Width="440" Height="10" Name="PrimaryProgressBar" HorizontalAlignment="Center" Margin="0,200,0,0" />
	<Button Content="{Common.Cancel}" Name="CancelButton" HorizontalAlignment="Center" Margin="0,240,0,0" Height="30" Width="100" />
</BloxstrapCustomBootstrapper>

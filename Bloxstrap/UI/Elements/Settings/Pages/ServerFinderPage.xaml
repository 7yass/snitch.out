<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ServerFinderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance dmodels:ServerFinderViewModel, IsDesignTimeCreatable=True}"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Title="ServerFinderPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Find a server worth joining. Paste any game link or place ID." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Margin="0,0,8,0" PlaceholderText="https://www.roblox.com/games/1818/..." Text="{Binding PlaceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="0,0,8,0" Icon="Search32" Content="Find servers" Command="{Binding SearchCommand, Mode=OneTime}" />
            <ComboBox Grid.Column="2" Width="150" Padding="10,5,10,5" ItemsSource="{Binding SortOptions, Mode=OneTime}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
        </Grid>

        <TextBlock Margin="0,16,0,0" FontSize="20" FontWeight="Medium" Text="{Binding GameTitle, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GameStats, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" />

        <ListBox Margin="0,8,0,0" MinHeight="200" MaxHeight="420"
                 ItemsSource="{Binding Servers, Mode=OneWay}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" Text="{Binding PlayersText}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DetailText}" TextWrapping="Wrap" />
                            <ProgressBar Margin="0,4,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding FillPercent, Mode=OneWay}" IsIndeterminate="False" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ShortId}" VerticalAlignment="Center" FontFamily="Consolas" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Icon="Play28" Content="Join server" Command="{Binding JoinCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,0" Content="Copy server ID" Command="{Binding CopyJobIdCommand, Mode=OneTime}" />
            <ui:Button Content="Load more" Command="{Binding LoadMoreCommand, Mode=OneTime}" />
        </StackPanel>
    </StackPanel>
</ui:UiPage>

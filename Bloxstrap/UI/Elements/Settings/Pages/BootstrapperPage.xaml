<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.BehaviourPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:BehaviourViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="2000" d:DesignWidth="800"
      Title="BehaviourPage"
      Scrollable="True">

    <StackPanel Style="{StaticResource Snitch.PagePanel}">

        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_Description}" Style="{StaticResource Snitch.PageHeader}" />

        <TextBlock Text="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}" Style="{StaticResource Snitch.SectionHeader}" />
        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxLanguage_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxLanguage_Description}"
            HelpLink="https://github.com/bloxstraplabs/bloxstrap/wiki/Information-on-Roblox-app-localisation">
            <ui:ToggleSwitch IsChecked="{Binding ForceRobloxLanguage, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Title}"
            Description="{x:Static resources:Strings.Menu_Behaviour_BackgroundUpdates_Description}">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundUpdates, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Nightly builds"
            Description="Update on every commit instead of tagged releases. Fresher features, higher chance of breakage.">
            <ui:ToggleSwitch IsChecked="{Binding NightlyUpdates, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Silent app updates"
            Description="Download and apply snitch.out updates automatically without asking first. When off, you'll be prompted before an update is installed.">
            <ui:ToggleSwitch IsChecked="{Binding SilentAppUpdates, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
        </controls:OptionControl>

        <ui:CardExpander Margin="0,24,0,0" Style="{StaticResource Snitch.SectionCard}" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Roblox version snapshots" Style="{StaticResource Snitch.SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="Pin a cached version-xxxx build for testing. Old builds cannot join live servers." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <controls:OptionControl
                    Header="Keep old versions"
                    Description="Don't delete cached version folders on update. Required to build up snapshots for comparison. Uses more disk space.">
                    <ui:ToggleSwitch IsChecked="{Binding KeepOldVersions, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
                </controls:OptionControl>
                <controls:OptionControl
                    Header="Pinned version"
                    Description="Empty = always latest. Pick a cached version-xxxx to block updates and launch it instead.">
                    <ComboBox Width="250" Padding="10,5,10,5" ItemsSource="{Binding InstalledVersionOptions, Mode=OneWay}" SelectedItem="{Binding PinnedVersionGuid, Mode=TwoWay}" />
                </controls:OptionControl>
                <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding PinStatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,0,0,0" Style="{StaticResource Snitch.SectionCard}" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Title}" Style="{StaticResource Snitch.SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Title}" 
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Description}">
                    <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding CleanerOptions, Mode=OneTime}" Text="{Binding CleanerOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>
                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
                </controls:OptionControl>
                <controls:OptionControl
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_StudioCache_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_StudioCache_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding CleanerStudioCache, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
                </controls:OptionControl>
                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
                </controls:OptionControl>
                <controls:OptionControl 
                    Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Title}"
                    Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding CleanerFishstrap, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="Experimental" Style="{StaticResource Snitch.SectionHeader}" />
        <TextBlock Text="A collection of experimental settings. Be careful while using them, as they may or may not work as intended." Style="{StaticResource Snitch.SectionDescription}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Bootstrapper_AllowCookieAccess_Title}"
            Description="{Binding Source={x:Static resources:Strings.Menu_Bootstrapper_AllowCookieAccess_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter='https://github.com/bloxstraplabs/bloxstrap/wiki'}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning20" Margin="0,2,8,0" Foreground="Orange">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CookieLoadingFailed, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" Value="True">
                                    <Setter Property="ui:SymbolIcon.Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <ui:ToggleSwitch IsChecked="{Binding CookieAccess, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Bootstrapper_Experimental_BetterMatchmaking_Title}"
            Description="{x:Static resources:Strings.Bootstrapper_Experimental_BetterMatchmaking_Description}">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding EnableBetterMatchmaking, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Bootstrapper_Experimental_BetterMatchmaking_RandomizeServer_Title}"
            Description="{x:Static resources:Strings.Bootstrapper_Experimental_BetterMatchmaking_RandomizeServer_Description}">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding EnableBetterMatchmakingRandomization, Mode=TwoWay}" Style="{StaticResource Snitch.ToggleSwitch}" />
            </StackPanel>
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>

<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:ChannelViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="ChannelPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">

        <TextBlock Margin="0,0,0,8" Text="{x:Static resources:Strings.Menu_Channel_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- ============================
             CHANNEL
             ============================ -->
        <TextBlock Text="Channel" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,8" />
        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            Choose which Roblox deployment channel to track. "Live" is the main public channel.
        </TextBlock>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Common_Channel}"
            Description="{x:Static resources:Strings.Menu_ChannelChanger_Description}">

            <StackPanel Orientation="Vertical">
                <!-- presets -->
                <ComboBox Margin="0,0,0,10" Padding="10,6,10,6" Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding ChannelPresets, Mode=OneTime}"
                          DisplayMemberPath="Key"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding ViewChannel, Mode=TwoWay}" />
                <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Or type a channel name directly (e.g. production, live, ptb)." />
                <ui:TextBox Margin="0,0,0,14" Padding="10,6,10,6" Width="220" HorizontalAlignment="Left"
                            PlaceholderText="production"
                            Text="{Binding ViewChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            </StackPanel>
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Channel_RobloxDomain_Title}"
            Description="{x:Static resources:Strings.Menu_Channel_RobloxDomain_Description}">
            <ui:TextBox Grid.Column="1" Margin="8,0,8,0" Padding="10,6,10,6" Width="220" HorizontalAlignment="Left"
                        PlaceholderText="roblox.com" Text="{Binding RobloxDomain}" />
        </controls:OptionControl>

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Title}"
            Description="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Description}">
            <ui:ToggleSwitch IsChecked="{Binding StaticDirectory, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================
             GO BACK VERSIONS
             ============================ -->
        <TextBlock Text="{x:Static resources:Strings.Menu_Deployment_GoBack_Title}" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,8" />
        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Deployment_GoBack_Description}" />

        <controls:OptionControl Header="{x:Static resources:Strings.Common_Version}">
            <ComboBox Margin="5,0,0,0" Padding="10,6,10,6" Width="260" HorizontalAlignment="Left"
                      ItemsSource="{Binding InstalledVersionOptions, Mode=OneWay}"
                      SelectedItem="{Binding PinnedVersionGuid, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource VersionGuidConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:OptionControl>

        <TextBlock Margin="0,4,0,8" FontSize="12" Text="{Binding PinStatusText, Mode=OneWay}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <!-- download any version -->
        <TextBlock Margin="0,12,0,6" FontSize="13" FontWeight="Medium"
                   Text="{x:Static resources:Strings.Menu_Deployment_DownloadVersion}" />
        <TextBlock Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Deployment_DownloadVersion_Description}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Padding="10,6,10,6" PlaceholderText="version-xxxx hash"
                        Text="{Binding DownloadVersionGuid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6,14,6"
                       Content="{Binding DownloadButtonText, Mode=OneWay}"
                       Command="{Binding DownloadVersionCommand, Mode=OneTime}"
                       IsEnabled="{Binding IsDownloadingVersion, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />
        </Grid>
        <TextBlock Margin="0,0,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding DownloadStatus, Mode=OneWay}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <controls:OptionControl 
            Header="{x:Static resources:Strings.Menu_Deployment_KeepOldVersions_Title}"
            Description="{x:Static resources:Strings.Menu_Deployment_KeepOldVersions_Description}">
            <ui:ToggleSwitch IsChecked="{Binding KeepOldVersions, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- ============================
             EXTERNAL INJECTION
             ============================ -->
        <TextBlock Text="{x:Static resources:Strings.Menu_Deployment_ExternalInjection_Title}" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,8" />
        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Deployment_ExternalInjection_Description}" />

        <controls:OptionControl Header="Executor-friendly mode">
            <ui:ToggleSwitch IsChecked="{Binding ExternalInjectionEnabled, Mode=TwoWay}" />
        </controls:OptionControl>

        <!-- injected dlls -->
        <TextBlock Margin="0,10,0,6" FontSize="13" FontWeight="Medium"
                   Text="{x:Static resources:Strings.Menu_Deployment_InjectedDlls}" />
        <TextBlock Margin="0,0,0,10" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{x:Static resources:Strings.Menu_Deployment_InjectedDlls_Description}" />
        <ListBox Margin="0,0,0,14" MinHeight="120" MaxHeight="220"
                 ItemsSource="{Binding InjectedDllStatus, Mode=OneWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Status}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ui:Button Margin="0,0,0,0" Icon="Folder24" Content="{x:Static resources:Strings.Menu_Deployment_OpenModsFolder}"
                   Command="{Binding OpenModificationsFolderCommand, Mode=OneTime}" HorizontalAlignment="Left" />

        <!-- ============================
             DEPLOY INFO
             ============================ -->
        <ui:CardExpander Margin="0,24,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Channel}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding ViewChannel, Mode=OneWay}" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Margin="8,0,8,0" Padding="10,6,10,6" Width="200" Text="{Binding ViewChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <Grid Margin="0,0,4,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Version}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.Version, Mode=OneWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_VersionGuid}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.VersionGuid, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Timestamp}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.Timestamp, Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowChannelWarning, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Grid.Column="0" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/MessageBox/Warning.png" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Deployment_Channel_OutOfDate}" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardControl Margin="0,16,0,0">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Channel_ChangeAction_Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Channel_ChangeAction_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Margin="5,0,0,0" Padding="10,6,10,6" Width="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding ChannelChangeModes.Keys, Mode=OneTime}"
                      Text="{Binding SelectedChannelChangeMode, Mode=TwoWay}" />
        </ui:CardControl>

    </StackPanel>
</ui:UiPage>
